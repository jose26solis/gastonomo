# Copiar a .env (que ya está en .gitignore) y llenar los valores.
# Nada de esto se sube al repositorio.

# ---- Microsoft identity platform (Outlook) ----
# Se obtienen registrando la app en https://portal.azure.com
GASTONOMO_MICROSOFT_CLIENT_ID=
GASTONOMO_MICROSOFT_CLIENT_SECRET=

# ---- Google Cloud (Gmail) ----
# Se obtienen registrando la app en https://console.cloud.google.com
GASTONOMO_GOOGLE_CLIENT_ID=
GASTONOMO_GOOGLE_CLIENT_SECRET=

# ---- Cifrado de tokens ----
# Generarla con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin esta variable el sistema arranca igual con una clave temporal (avisa por
# warning), pero los tokens cifrados no sobreviven un reinicio.
GASTONOMO_CLAVE_CIFRADO_TOKENS=